// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  password      String
  name          String
  avatar        String?
  role          UserRole  @default(Student)
  status        UserStatus @default(Active)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  papers        Paper[]
  documents     Document[]
  subscriptions Subscription[]
  usageLogs     UsageLog[]
  aigcDetections AIGCDetection[]
  
  @@map("users")
}

enum UserRole {
  Student
  Graduate
  Scholar
}

enum UserStatus {
  Active
  Inactive
  Banned
}

// 论文表
model Paper {
  id            String      @id @default(uuid())
  userId        String
  title         String
  content       String      @db.Text
  originalText  String?     @db.Text
  processedText String?     @db.Text
  status        PaperStatus @default(Draft)
  plagiarismRate Float?
  aigcRate      Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations     PaperCitation[]

  @@map("papers")
}

enum PaperStatus {
  Draft
  Processing
  Completed
  Failed
}

// 文献表
model Document {
  id                String         @id @default(uuid())
  userId            String
  title             String
  authors           String
  journal           String?
  year              Int?
  volume            String?
  issue             String?
  pages             String?
  doi               String?        @unique
  url               String?
  abstract          String?        @db.Text
  keywords          String[]
  content           String?        @db.Text
  filePath          String?
  embedding         Float[]
  type              DocumentType   @default(JOURNAL_ARTICLE)
  university        String?
  degreeType        DegreeType?
  publisher         String?
  edition           String?
  isbn              String?
  location          String?
  conferenceName    String?
  conferenceLocation String?
  editors           String?
  websiteName       String?
  accessDate        DateTime?
  publishDate       DateTime?
  patentNumber      String?
  inventors         String?
  filingDate        DateTime?
  issuingAuthority  String?
  notes             String?         @db.Text
  citationCount     Int             @default(0)
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperCitations    PaperCitation[]

  @@map("documents")
}

// 订阅表
model Subscription {
  id            String          @id @default(uuid())
  userId        String
  plan          SubscriptionPlan
  status        SubscriptionStatus @default(Active)
  startDate     DateTime
  endDate       DateTime
  wordQuota     Int
  wordsUsed     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("subscriptions")
}

enum SubscriptionPlan {
  Basic
  Professional
  Team
}

enum SubscriptionStatus {
  Active
  Expired
  Cancelled
}

// 使用日志表
model UsageLog {
  id            String      @id @default(uuid())
  userId        String
  action        String
  resource      String
  wordsUsed     Int         @default(0)
  cost          Float       @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_logs")
}

// AIGC检测记录表
model AIGCDetection {
  id                String                @id @default(uuid())
  userId            String
  title             String
  content           String?               @db.Text
  encryptedContent  String?               @db.Text
  contentHash       String?
  source            String?               @default("manual")
  overallScore      Float
  riskLevel         AIGCRiskLevel        @default(Medium)
  paragraphCount    Int
  highRiskCount     Int                  @default(0)
  status            AIGCDetectionStatus  @default(Pending)
  result            Json?
  optimizationRounds Int?                @default(0)
  processingTimeMs  Int?
  creditsConsumed   Float?               @default(0)
  paperId           String?
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  optimizations     OptimizationRecord[]

  @@map("aigc_detections")
}

enum AIGCRiskLevel {
  Low
  Medium
  MediumHigh
  High
}

enum AIGCDetectionStatus {
  Pending
  Processing
  Analyzing
  Completed
  Analyzed
  Failed
}

// AIGC优化记录表（降痕操作）
model OptimizationRecord {
  id                    String                @id @default(uuid())
  detectionId           String
  roundNumber           Int?
  operationType         String?
  paragraphIndex        Int?
  originalScore         Float?
  rewrittenScore        Float?
  beforeAigcRate        Float?
  afterAigcRate         Float?
  rateChange            Float?
  versionType           RewriteVersionTypeEnum @default(Balanced)
  adopted               Boolean               @default(false)
  targetParagraphIndices Int[]
  selectedVersion      Int?
  beforeTextHash        String?
  detail                Json?
  diffData              Json?
  processingTimeMs      Int?
  costCredits           Float?
  deletedAt             DateTime?
  createdAt             DateTime              @default(now())

  detection             AIGCDetection         @relation(fields: [detectionId], references: [id], onDelete: Cascade)

  @@map("optimization_records")
}

enum RewriteVersionTypeEnum {
  Conservative
  Balanced
  Aggressive
}

// ========== 知识库与引用管理 ==========

enum DocumentType {
  JOURNAL_ARTICLE
  THESIS
  BOOK
  CONFERENCE_PAPER
  WEBPAGE
  PATENT
}

enum DegreeType {
  BACHELOR
  MASTER
  DOCTOR
}

enum CitationFormat {
  GBT7714
  APA7
  MLA9
}

// 论文-文献引用关联表
model PaperCitation {
  id             String         @id @default(uuid())
  paperId        String
  documentId     String
  citationNumber Int
  citationText   String?        @db.Text
  format         CitationFormat @default(GBT7714)
  position       Int?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  paper          Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([paperId, citationNumber])
  @@index([documentId])
  @@index([paperId, documentId])
  @@unique([paperId, documentId, position])
  @@map("paper_citations")
}
